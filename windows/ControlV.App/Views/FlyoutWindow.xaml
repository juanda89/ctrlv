<Window x:Class="ControlV.App.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ControlV.App.ViewModels"
        Title="ctrl+v" Width="340" Height="600" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent" Deactivated="OnDeactivated">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Vis"/>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="12"/>
      <Setter Property="BorderBrush" Value="#E2E8F0"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,12"/><Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#64748B"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="Title" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#1E293B"/></Style>
    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Background" Value="#3B82F6"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="12,6"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Chip" TargetType="ToggleButton">
      <Setter Property="Padding" Value="9,5"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
        <Border x:Name="B" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="B" Property="Background" Value="#E3EDFD"/><Setter TargetName="B" Property="BorderBrush" Value="#93B4F5"/><Setter Property="Foreground" Value="#1D4ED8"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>

  <Border Background="#F8FAFC" CornerRadius="14" BorderBrush="#CBD5E1" BorderThickness="1" Padding="12">
    <DockPanel>
      <DockPanel DockPanel.Dock="Top" Margin="2,0,2,10">
        <TextBlock Text="ctrl+v" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <TextBlock Text="{Binding ModifierLabel}" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
          <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="7,2"><TextBlock Text="{Binding SelectedLetter}" FontWeight="SemiBold"/></Border>
        </StackPanel>
      </DockPanel>

      <DockPanel DockPanel.Dock="Bottom" Margin="2,6,2,0">
        <Button Content="⋯" HorizontalAlignment="Right" Width="30" Click="OnMenuClick">
          <Button.ContextMenu><ContextMenu>
            <MenuItem Header="Feedback" Command="{Binding OpenFeedbackCommand}"/>
            <MenuItem Header="Debug" Click="OnDebugClick"/>
            <Separator/>
            <MenuItem Header="Quit ctrl+v" Click="OnQuitClick"/>
          </ContextMenu></Button.ContextMenu>
        </Button>
      </DockPanel>

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <!-- Sign-in (inline swap, never a dialog) -->
          <Border Style="{StaticResource Card}" Visibility="{Binding ShowSignIn, Converter={StaticResource Vis}}">
            <StackPanel>
              <DockPanel><TextBlock Text="{Binding SignInTitle}" Style="{StaticResource Title}"/><Button Content="✕" HorizontalAlignment="Right" Command="{Binding CloseSignInCommand}" BorderThickness="0" Background="Transparent"/></DockPanel>
              <StackPanel Visibility="{Binding IsAwaitingCode, Converter={StaticResource Vis}, ConverterParameter=inverse}" x:Name="EmailStep">
                <TextBlock Text="Enter your email to continue. We'll send you a 6-digit code." Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,6"/>
                <TextBox Text="{Binding EmailInput, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                <Button Content="Continue" Style="{StaticResource Primary}" Command="{Binding SubmitEmailCommand}" HorizontalAlignment="Right" Margin="0,8,0,0"/>
              </StackPanel>
              <StackPanel Visibility="{Binding IsAwaitingCode, Converter={StaticResource Vis}}">
                <TextBlock Text="We sent you a 6-digit code." Style="{StaticResource Label}" Margin="0,6"/>
                <TextBox Text="{Binding CodeInput, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" Padding="6,4"/>
                <Button Content="Verify" Style="{StaticResource Primary}" Command="{Binding SubmitCodeCommand}" HorizontalAlignment="Right" Margin="0,8,0,0"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Feedback (inline swap) -->
          <Border Style="{StaticResource Card}" Visibility="{Binding ShowFeedback, Converter={StaticResource Vis}}" DataContext="{Binding Feedback}">
            <StackPanel>
              <DockPanel><TextBlock Text="Your feedback" Style="{StaticResource Title}"/><Button Content="✕" HorizontalAlignment="Right" Click="OnCloseFeedback" BorderThickness="0" Background="Transparent"/></DockPanel>
              <StackPanel Visibility="{Binding DidSend, Converter={StaticResource Vis}}">
                <TextBlock Text="Thank you! Every message is read by a person." TextWrapping="Wrap" Margin="0,8"/>
              </StackPanel>
              <StackPanel x:Name="FeedbackForm">
                <TextBlock Text="Rating" Style="{StaticResource Label}" Margin="0,6,0,2"/>
                <StackPanel Orientation="Horizontal" x:Name="Stars">
                  <Button Content="★" Tag="1" Click="OnStarClick" Background="Transparent" BorderThickness="0" FontSize="20"/>
                  <Button Content="★" Tag="2" Click="OnStarClick" Background="Transparent" BorderThickness="0" FontSize="20"/>
                  <Button Content="★" Tag="3" Click="OnStarClick" Background="Transparent" BorderThickness="0" FontSize="20"/>
                  <Button Content="★" Tag="4" Click="OnStarClick" Background="Transparent" BorderThickness="0" FontSize="20"/>
                  <Button Content="★" Tag="5" Click="OnStarClick" Background="Transparent" BorderThickness="0" FontSize="20"/>
                </StackPanel>
                <TextBlock Text="What is it about?" Style="{StaticResource Label}" Margin="0,6,0,2"/>
                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}"/>
                <TextBlock Text="Message" Style="{StaticResource Label}" Margin="0,6,0,2"/>
                <TextBox Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="64" TextWrapping="Wrap" Padding="6,4"/>
                <TextBlock Text="Email (optional, so we can reply)" Style="{StaticResource Label}" Margin="0,6,0,2"/>
                <TextBox Text="{Binding ContactEmailInput, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                <TextBlock Text="{Binding LastError}" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <Button Content="Send" Style="{StaticResource Primary}" Command="{Binding SendCommand}" IsEnabled="{Binding CanSend}" HorizontalAlignment="Right" Margin="0,8,0,0"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Status -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel>
                <TextBlock Text="{Binding StatusTitle}" Style="{StaticResource Title}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button Content="Manage" Command="{Binding ManageCommand}" Visibility="{Binding IsActive, Converter={StaticResource Vis}}" Margin="0,0,6,0"/>
                  <Button Content="Upgrade" Style="{StaticResource Primary}" Command="{Binding UpgradeCommand}" x:Name="UpgradeButton"/>
                </StackPanel>
              </DockPanel>
              <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Label}" Margin="0,4,0,0" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>

          <!-- Feedback invite (once, after real use) -->
          <Border Style="{StaticResource Card}" Visibility="{Binding Feedback.ShouldInvite, Converter={StaticResource Vis}}">
            <DockPanel>
              <Button Content="Later" DockPanel.Dock="Right" Command="{Binding Feedback.DismissCommand}" BorderThickness="0" Background="Transparent" Foreground="#94A3B8"/>
              <StackPanel><TextBlock Text="Enjoying ctrl+v?" Style="{StaticResource Title}"/><TextBlock Text="Tap a star to rate it." Style="{StaticResource Label}"/></StackPanel>
            </DockPanel>
          </Border>

          <!-- Profile tabs -->
          <Border Style="{StaticResource Card}" Padding="10,8">
            <StackPanel Orientation="Horizontal">
              <ItemsControl ItemsSource="{Binding Tabs}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding IsSelected, Mode=OneWay}" Click="OnTabClick">
                      <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Shortcut}" Margin="6,0,0,0" Foreground="#94A3B8" FontSize="10"/></StackPanel>
                    </ToggleButton>
                  </StackPanel>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="+" Width="26" Height="26" Command="{Binding AddProfileCommand}" Visibility="{Binding CanAddProfile, Converter={StaticResource Vis}}"/>
              <Button Content="✕" Width="26" Height="26" Margin="6,0,0,0" Command="{Binding RemoveProfileCommand}" CommandParameter="{Binding SelectedTab}" Visibility="{Binding SelectedTab.Removable, Converter={StaticResource Vis}, FallbackValue=Collapsed}" ToolTip="Remove this profile"/>
            </StackPanel>
          </Border>

          <!-- Preferences of the selected profile -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel><TextBlock Text="Translate to" Style="{StaticResource Title}"/><ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" HorizontalAlignment="Right" MinWidth="140"/></DockPanel>
              <Separator Margin="0,10"/>
              <TextBlock Text="Tone" Style="{StaticResource Title}"/>
              <ComboBox ItemsSource="{Binding Tones}" SelectedItem="{Binding SelectedTone}" Margin="0,6,0,0"/>
              <StackPanel Visibility="{Binding IsCustomTone, Converter={StaticResource Vis}}">
                <TextBlock Text="Custom prompt" Style="{StaticResource Label}" Margin="0,8,0,2"/>
                <TextBox Text="{Binding CustomTonePrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="56" TextWrapping="Wrap" Padding="6,4"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Shortcut (selected profile) -->
          <Border Style="{StaticResource Card}">
            <DockPanel>
              <StackPanel><TextBlock Text="Shortcut" Style="{StaticResource Title}"/><TextBlock Text="{Binding SelectedProfileName}" Style="{StaticResource Label}"/></StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{Binding ModifierLabel}" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox ItemsSource="{Binding Letters}" SelectedItem="{Binding SelectedLetter}" Width="56"/>
              </StackPanel>
            </DockPanel>
          </Border>

          <!-- Auto-paste (global) -->
          <Border Style="{StaticResource Card}">
            <DockPanel>
              <StackPanel><TextBlock Text="Auto-paste" Style="{StaticResource Title}"/><TextBlock Text="Applies to all profiles" Style="{StaticResource Label}"/></StackPanel>
              <CheckBox IsChecked="{Binding AutoPaste}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
          </Border>

          <!-- Feedback card (always visible) -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="How's ctrl+v working for you?" Style="{StaticResource Title}"/>
              <TextBlock Text="Rate it, request a feature, or tell us what broke." Style="{StaticResource Label}" TextWrapping="Wrap"/>
              <Button Content="Leave feedback ›" Command="{Binding OpenFeedbackCommand}" HorizontalAlignment="Left" BorderThickness="0" Background="Transparent" Foreground="#3B82F6" FontWeight="SemiBold" Margin="0,6,0,0" Padding="0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
